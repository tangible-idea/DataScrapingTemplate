# 홈택스 자동화 설정 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#
# 셸에서 export 한 환경변수가 .env 보다 우선합니다.
# 비워두면 실행 중 콘솔에서 입력받습니다(비밀번호는 화면에 찍히지 않음).

# 홈택스 아이디
HOMETAX_ID=

# 홈택스 비밀번호
HOMETAX_PW=

# 2차 인증용 주민등록번호 앞 6자리 (생년월일)
HOMETAX_JUMIN_FRONT=

# 2차 인증용 주민등록번호 뒤 1자리 (성별 구분 숫자)
HOMETAX_JUMIN_BACK=
